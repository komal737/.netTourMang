@{
    ViewData["Title"] = "Migrate Passwords";
}

<h2>Migrate Plaintext Passwords</h2>

<p>Accounts with non-hashed passwords detected: <strong>@ViewBag.PlaintextCount</strong></p>

@if (ViewBag.PlaintextCount > 0)
{
    <p>This will hash existing plaintext passwords for these accounts. This operation is one-time and cannot be undone. Users will keep their current passwords; only the stored value will be hashed.</p>

    <h5>Accounts to be migrated</h5>
    <ul>
        @foreach (var email in (IEnumerable<string>?)ViewBag.Candidates ?? new List<string>())
        {
            <li>@email</li>
        }
    </ul>

    <form asp-action="MigratePasswordsPost" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Run Migration Now</button>
    </form>
}
else
{
    <p>No plaintext passwords detected. No action required.</p>
}

<p><a class="btn btn-secondary" href="@Url.Action("ManageUsers", "Admin")">Back to Users</a></p>

@if (ViewBag.Migrated != null)
{
    <h5 class="mt-4">Migrated accounts</h5>
    <ul>
        @foreach (var email in (IEnumerable<string>)ViewBag.Migrated)
        {
            <li>@email</li>
        }
    </ul>
}
