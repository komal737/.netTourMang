@model TourManagement_MVC.Models.ViewModels.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Portal Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
                <div class="text-center mb-4">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="bi bi-shield-lock-fill me-1"></i> Restricted Area
                    </span>
                    <h2 class="fw-bold">Admin Portal</h2>
                    <p class="text-muted">Sign in with administrator credentials.</p>
                </div>

                <!-- Default admin credentials removed from UI for security -->

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="Email" class="form-control" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg fw-bold py-2 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Access Dashboard
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Return to Website
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
